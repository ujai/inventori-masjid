{
  "name": "inventory-masjid",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source inventory management system for mosques (Sistem Inventori Masjid)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ujai/inventori-masjid.git"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "bun run db/migrate-local.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run db/seed.ts",
    "db:seed:samples": "bun run db/seed-samples.ts",
    "db:create-admin": "bun run db/create-admin.ts",
    "test:uat": "playwright test --project=admin --project=no-auth --project=mobile",
    "test:uat:admin": "playwright test --project=admin",
    "test:uat:ajk": "playwright test --project=ajk",
    "test:uat:mobile": "playwright test --project=mobile",
    "test:uat:all": "playwright test",
    "test:uat:setup:admin": "SETUP_ROLE=admin playwright test --project=setup:admin",
    "test:uat:setup:ajk": "SETUP_ROLE=ajk playwright test --project=setup:ajk",
    "test:auth:local": "bun run tests/local-auth.ts",
    "test:uat:report": "playwright show-report playwright-report",
    "screenshot:guides": "bun run tests/screenshots.ts",
    "test:security": "bun test tests/security",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@neondatabase/serverless": "^1.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-qr-code": "^2.2.0",
    "resend": "^6.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "shell-quote": "^1.8.4",
    "esbuild": "^0.28.1"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "sharp"
  ]
}
