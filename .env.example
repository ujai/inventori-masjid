# =====================================================
# Inventori Masjid - Environment Variables
# Copy this file to .env.local and fill in real values.
# Setup guide: docs/01-account-setup-guide.md
# =====================================================

# -----------------------------------------------------
# Branding (shown in header, emails, Telegram, PDF reports)
# -----------------------------------------------------
NEXT_PUBLIC_ORG_NAME="Masjid Contoh"
# Optional; defaults to "Inventori <NEXT_PUBLIC_ORG_NAME>"
NEXT_PUBLIC_APP_NAME=""

# -----------------------------------------------------
# App URLs (use your deployed URL in production)
# -----------------------------------------------------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------
# Database (Neon PostgreSQL) - REQUIRED
# Setup guide: docs/01-account-setup-guide.md - Section 2
# -----------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/inventory_masjid?sslmode=require"
# Local Docker alternative (docker-compose.yml):
# DATABASE_URL="postgres://postgres:postgres@db.localtest.me:5432/main"

# -----------------------------------------------------
# Better Auth - REQUIRED
# Generate secret: openssl rand -base64 32
# -----------------------------------------------------
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# -----------------------------------------------------
# Google OAuth - REQUIRED (the only sign-in method)
# Setup guide: docs/01-account-setup-guide.md - Section 4
# -----------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------
# Cron security - generate with: openssl rand -hex 32
# -----------------------------------------------------
CRON_SECRET=""

# -----------------------------------------------------
# Cloudflare R2 (photo/attachment storage)
# Required only for photo uploads.
# Setup guide: docs/01-account-setup-guide.md - Section 3
# -----------------------------------------------------
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="inventory-masjid"
R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"

# -----------------------------------------------------
# Resend (email) - optional; emails are logged to console when unset
# Setup guide: docs/01-account-setup-guide.md - Section 5
# -----------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Inventori Masjid <noreply@YOUR_DOMAIN>"

# -----------------------------------------------------
# Telegram bot - optional
# Setup guide: docs/01-account-setup-guide.md - Section 6
# -----------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# -----------------------------------------------------
# UAT tests (Playwright) - target environment
# -----------------------------------------------------
UAT_BASE_URL="http://localhost:3000"
